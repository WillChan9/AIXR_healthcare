{
  "room_type": "Rehabilitation Corridor",
  "description": "Elongated room, linear layout",
  "layout_goals": {
    "interior_bounds": "3m x 10m",
    "minimum_objects": 8,
    "focal_point": "entrance"
  },
  "steps": [
    {
      "step": 1,
      "action": "Install handrails",
      "objects": [
        "Handrail_01",
        "Handrail_02"
      ],
      "target_area": "left and right walls at z~3.0",
      "condition": "handrails parallel to each other and to the dominant axis (z-direction)"
    },
    {
      "step": 2,
      "action": "Install additional handrails",
      "objects": [
        "Handrail_03",
        "Handrail_04"
      ],
      "target_area": "left and right walls at z~6.0",
      "condition": "handrails parallel to each other and to the dominant axis (z-direction)"
    },
    {
      "step": 3,
      "action": "Place wheelchair and walker",
      "objects": [
        "WheelChair_01",
        "Walker_01"
      ],
      "target_area": "near entrance, z~1.0 and z~1.5",
      "condition": "objects do not obstruct doorway and are aligned with dominant axis"
    },
    {
      "step": 4,
      "action": "Install bench",
      "objects": [
        "Bench_01"
      ],
      "target_area": "midway rest point, z~5.0",
      "condition": "bench is centered and does not obstruct handrails"
    },
    {
      "step": 5,
      "action": "Place caution sign",
      "objects": [
        "Caution_Sign_01"
      ],
      "target_area": "entrance, z~0.5",
      "condition": "sign is visible and does not obstruct doorway"
    },
    {
      "step": 6,
      "action": "Position staff and patient",
      "objects": [
        "Patient_01",
        "Nurse_01"
      ],
      "target_area": "corridor, z~4.0 and z~4.5",
      "condition": "patient and nurse are in a safe and accessible location"
    }
  ]
}